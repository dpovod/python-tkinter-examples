source "https://rubygems.org"

# Пряма залежність від Jekyll 3.9.x (версія, яку GitHub Pages використовує
# для збірки сайтів) замість гема "github-pages": той тягне купу плагінів
# і залежностей із нативними розширеннями (eventmachine, nokogiri…), які не
# компілюються в цьому середовищі. Для локальної збірки достатньо самого
# Jekyll і двох плагінів з білого списку, якими ми користуємось.
gem "jekyll", "~> 3.9.5"
gem "jekyll-seo-tag"
gem "jekyll-sitemap"
gem "webrick"
